function getConversationState(id) {
  const key = String(id || '').trim();

  if (!key) {
    return null;
  }

  if (
    typeof userInteractions !== 'undefined' &&
    userInteractions[key]
  ) {
    return userInteractions[key];
  }

  return null;
}

