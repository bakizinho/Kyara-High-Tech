function getHistoricoStats() {

  const stats = {
    totalConversas:
      Object.keys(
        historico
      ).length,

    conversasAtivas: 0,

    totalMensagens: 0
  };

  const limite =
    Date.now() -
    60 * 60 * 1000;

  for (
    const conversa
    of Object.values(
      historico
    )
  ) {

    stats.totalMensagens +=
      conversa.length;

    const ultima =
      conversa[
        conversa.length - 1
      ];

    if (
      ultima &&
      new Date(
        ultima.timestamp
      ).getTime() > limite
    ) {

      stats.conversasAtivas++;

    }
  }

  return stats;
}

